{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "entities": {
    "users": {
      "path": "users/{userId}",
      "description": "User profile document",
      "fields": {
        "uid": { "type": "string", "description": "Firebase user ID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User avatar URL" },
        "isAnonymous": { "type": "boolean", "description": "Whether user signed in as guest" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "subcollections": {
        "resumes": {
          "path": "users/{userId}/resumes/{resumeId}",
          "description": "User resumes containing structured data, target role, ATS scores, and versions",
          "fields": {
            "id": { "type": "string", "description": "Resume unique identifier" },
            "userId": { "type": "string", "description": "Owner user ID" },
            "title": { "type": "string", "description": "Resume title or role name" },
            "personalInfo": { "type": "object", "description": "Contact and personal details" },
            "summary": { "type": "string", "description": "Professional summary statement" },
            "experience": { "type": "array", "description": "Work experience entries" },
            "education": { "type": "array", "description": "Education credentials" },
            "skills": { "type": "array", "description": "Skills and proficiencies" },
            "projects": { "type": "array", "description": "Highlighted projects" },
            "certifications": { "type": "array", "description": "Certifications" },
            "parsedText": { "type": "string", "description": "Raw parsed plain text" },
            "jobTarget": { "type": "string", "description": "Target job role or industry" },
            "atsScore": { "type": "number", "description": "Latest ATS analysis score" },
            "tailoredVersions": { "type": "array", "description": "Tailored variants for specific jobs" },
            "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
            "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
          }
        },
        "applications": {
          "path": "users/{userId}/applications/{applicationId}",
          "description": "Job applications tracking pipeline",
          "fields": {
            "id": { "type": "string", "description": "Application ID" },
            "userId": { "type": "string", "description": "Owner user ID" },
            "company": { "type": "string", "description": "Company name" },
            "position": { "type": "string", "description": "Job title/position" },
            "status": { "type": "string", "description": "Pipeline status (wishlist, applied, interview, offer, rejected)" },
            "location": { "type": "string", "description": "Job location" },
            "salary": { "type": "string", "description": "Compensation notes" },
            "resumeId": { "type": "string", "description": "Associated resume ID" },
            "coverLetterId": { "type": "string", "description": "Associated cover letter ID" },
            "jobDescriptionId": { "type": "string", "description": "Associated JD ID" },
            "matchScore": { "type": "number", "description": "ATS or profile match percentage" },
            "notes": { "type": "string", "description": "User notes" },
            "createdAt": { "type": "string", "description": "ISO timestamp created" },
            "updatedAt": { "type": "string", "description": "ISO timestamp updated" }
          }
        },
        "coverLetters": {
          "path": "users/{userId}/coverLetters/{clId}",
          "description": "Tailored cover letters",
          "fields": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "content": { "type": "string" },
            "createdAt": { "type": "string" },
            "updatedAt": { "type": "string" }
          }
        },
        "jobDescriptions": {
          "path": "users/{userId}/jobDescriptions/{jdId}",
          "description": "Saved job postings and parsed targets",
          "fields": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "company": { "type": "string" },
            "createdAt": { "type": "string" }
          }
        },
        "atsReports": {
          "path": "users/{userId}/atsReports/{reportId}",
          "description": "ATS scoring and audit reports",
          "fields": {
            "id": { "type": "string" },
            "score": { "type": "number" },
            "createdAt": { "type": "string" }
          }
        }
      }
    }
  },
  "security": {
    "rules": "User isolation: Users can only read, write, and delete documents under their own user path users/{userId}/**. Anonymous and authenticated users are supported."
  }
}
